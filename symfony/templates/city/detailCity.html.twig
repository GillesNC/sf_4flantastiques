{% extends 'base.html.twig' %}

{% block title %}4Flantastiques - {{ city.name }}{% endblock %}

{% block body %}
    <section class="flex flex-col max-w-7xl mx-auto m-25 gap-8">
        {{ include('components/_breadscrumb.html.twig', {centered: true}) }}
        <h2 class="text-secondary text-center mb-8">Tous les enseignes de {{ city.name }}</h2>
        <div class="flex justify-center">
            <a href="{{ path('register') }}" class="btn-primary">Devenir flanneur</a>
        </div>
    </section>

    {# SECTION FLAN & FILTRE #}
    <section class="flex max-w-7xl mx-auto m-20 gap-8">
        <div class="grid grid-cols-3 md:grid-cols-2 gap-8">
            {% for spot in spots %}
                {{ include('components/_cardSpot.html.twig') }}
            {% endfor %}
        </div>
    </section>


    {# SECTION MEMBER #}
    {{ include('components/_member.html.twig') }}

{% endblock %}
