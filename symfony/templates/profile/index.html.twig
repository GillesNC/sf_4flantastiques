{% extends 'base.html.twig' %}

{% block title %}Votre compte {{ user.pseudo }}{% endblock %}

{% block body %}
    <section class="hero flex flex-col max-w-7xl mx-auto m-25 gap-8">
        <h1 class="text-secondary">Mon compte flanneur</h1>
        <div class="dashboard grid grid-cols-2  max-w-7xl mx-auto gap-10 ">
            <div class="flex flex-col gap-4">
                <h3 class="text-secondary">Tableau de bord</h3>
                <div class="panel flex flex-col px-6 py-6 border-1 border-solid rounded">
                    <ul class="flex flex-col gap-4">
                        <li><a href="{{ path('home') }}" class="text-secondary btn-outline">Mon profil</a></li>
                        <li><a href="{{ path('home') }}" class="text-secondary hover:text-primary">Mes avis</a></li>
                        <li><a href="{{ path('home') }}" class="text-secondary hover:text-primary">Mes flans soumis</a></li>
                        <li><a href="{{ path('home') }}" class="text-secondary hover:text-primary">Mes flans favoris</a></li>
                        <li><a href="{{ path('home') }}" class="text-secondary hover:text-primary">Charte UGC</a></li>
                        <li><a href="{{ path('home') }}" class="text-secondary hover:text-primary">Déconnexion</a></li>
                    </ul>
                </div>
            </div>
            <div class="flex flex-col gap-4">
                <h2 class="text-secondary">Bienvenue {{ user.pseudo }} !</h2>
                <p>{{ user.bio }}</p>
            </div>
        </div>
    </section>
{% endblock %}
