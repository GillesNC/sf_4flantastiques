{% extends 'base.html.twig' %}

{% block title %}Devenir flanneur{% endblock %}

{% block body %}
    <div class="breadscrumb max-w-7xl mx-auto py-10 gap-8 lg:mx-auto">
        <p>Mon fil d'ariane</p>
    </div>
    <section class="form flex flex-col max-w-7xl mx-auto p-10 mb-50 gap-8 border-1 border-solid border-secondary rounded-xl lg:mx-auto">
        <h1 class="text-secondary">Créer mon compte</h1>

        {{ form_errors(registrationForm) }}

        {{ form_start(registrationForm) }}
        {{ form_widget(registrationForm) }}
        <button type="submit" class="btn-primary mt-10 px-10">S'enregistrer</button>
        {{ form_end(registrationForm) }}
    </section>
{% endblock %}
