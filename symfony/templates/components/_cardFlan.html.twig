<article class="card-flan">
    {% for photo in flan.photo %}
        <img src="{{ photo }}" alt="">
    {% endfor %}
    <div class="card-content flex flex-col gap-4 backdrop-filter backdrop-blur-sm bg-opacity-10 ">
        <h3 class="card-title text-secondary">{{ flan.name }}</h3>
        <p class="text-secondary">Ville :</p>
        <p class="text-secondary">Prix : {{ flan.price }} €</p>
        <p class="text-secondary">Note : {{ flan.avgScore }}/5</p>
        <a class="btn-primary">Découvrir</a>
    </div>
</article>
