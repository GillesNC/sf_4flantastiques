<section class="city max-w-7xl mx-auto m-50">
    <div class="flex items-center justify-between gap-4 mb-8">
        <h2 class="text-secondary text-center mb-8">Nos enseignes par ville</h2>
        <a href="{{ path('city') }}" class="btn-secondary">Découvrir toutes les villes</a>
    </div>
    <div class="flex gap-8">
        {% for city in cities %}
            <a href="{{ path('city_detail', {'id': city.id}) }}">
                <article class="card-city">
                    <div class="card-content-city relative">
                        <img
                            src="https://images.unsplash.com/photo-1609971757431-439cf7b4141b?q=80&w=687&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
                            class="backdrop:bg-black/50"
                            alt="">
                        <div class="absolute inset-0 bg-opacity-50 flex items-center justify-center">
                            <h3 class="card-title text-secondary text-center">{{ city.name }}</h3>
                        </div>
                    </div>
                </article>
            </a>
        {% endfor %}
    </div>
</section>
