<article class="card-spot">
    {% if spot.documents is not empty %}
        <img src="{{ asset('uploads/documents/' ~ spot.documents|first.path) }}" alt="{{ spot.name }}">
    {% else %}
        <img src="{{ asset('images/default_spot.webp') }}" alt="Image par défaut du flan">
    {% endif %}
    <div class="card-content flex flex-col gap-4 backdrop-filter backdrop-blur-sm bg-opacity-10 ">
        <h3 class="card-title text-secondary">{{ spot.name }}</h3>
        {% if spot.city is defined %}
            <p class="text-secondary">Ville : {{ spot.city.name }}</p>
        {% else %}
            <p class="text-secondary">Ville : Non renseigné</p>
        {% endif %}
        <a class="btn-primary" href="{{ path('spot_detail', {'id': spot.id}) }}">Découvrir</a>
    </div>
</article>
